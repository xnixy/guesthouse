+++ b/hw/hyperv/gpupv.c
@@ -408,6 +408,9 @@ static void gpupv_vgpu_class_init(ObjectClass *klass, const void *data)
 #define GPUPV_CFG_END       224
 
 #define TYPE_GPUPV_RENDER "gpupv-render"
+/* Microsoft's virtual render device, which the inbox driver binds to. */
+#define GPUPV_RENDER_VENDOR 0x1414
+#define GPUPV_RENDER_DEVICE 0x008e
 OBJECT_DECLARE_SIMPLE_TYPE(GpupvRender, GPUPV_RENDER)
 
 struct GpupvRender {
@@ -416,6 +419,8 @@ struct GpupvRender {
     uint64_t luid;
