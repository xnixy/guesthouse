From a4e9c8029193760d65c1885585871dfa54a13faa Mon Sep 17 00:00:00 2001
From: xnixy <x@ruxn.com>
Date: Sat, 7 Nov 2026 23:13:31 -0800
Subject: [PATCH 27/27] hw/misc/nvfwd: forward to the card it is given

On a host with more than one NVIDIA card the device opened /dev/nvidia0 and
left the guest's device instance as it was, so a guest could get another card
than the one asked for. Give the device card= (the card's PCI address) and
card-minor= (its device file). Before the guest runs it asks the RM which GPU
and device instance are at that address, and keeps the card's file open.

Whichever GPU file the guest opens, it gets that card's. The guest's device 0
is made on the card's instance, and any other device instance is refused. The
answers that list GPUs and device numbers are cut down to the card, which the
guest sees as its device 0, and a call naming another GPU is refused. The
render node is the one at the card's address.

With no card= the host's only card is used, as before, and a host with two
refuses to start the device.
---
 hw/misc/nvfwd/card.c      | 435 ++++++++++++++++++++++++++++++++++++++
 hw/misc/nvfwd/card.h      |  66 ++++++
 hw/misc/nvfwd/fds.c       |   3 +-
 hw/misc/nvfwd/forward.c   |  23 ++
 hw/misc/nvfwd/host_card.c | 152 +++++++++++++
 hw/misc/nvfwd/meson.build |   2 +
 hw/misc/nvfwd/nvfwd.c     |   6 +
 hw/misc/nvfwd/nvfwd.h     |  13 +-
 hw/misc/nvfwd/rm_layout.h |   1 +
 hw/misc/nvfwd/show.c      |  12 +-
 10 files changed, 707 insertions(+), 6 deletions(-)
 create mode 100644 hw/misc/nvfwd/card.c
 create mode 100644 hw/misc/nvfwd/card.h
 create mode 100644 hw/misc/nvfwd/host_card.c

diff --git a/hw/misc/nvfwd/card.c b/hw/misc/nvfwd/card.c
new file mode 100644
index 0000000..706d9b4
--- /dev/null
+++ b/hw/misc/nvfwd/card.c
@@ -0,0 +1,435 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* The one card a guest gets. See card.h. Layouts are from NVIDIA's ctrl0000gpu.h and nv-ioctl.h. */
+#include "card.h"
+
+#include <stdio.h>
+#include <string.h>
+#include "rm_layout.h"
+
+#define CLASS_DEVICE 0x80             /* NV01_DEVICE_0 */
+#define DEVICE_PARAMS_ID 0            /* NV0080_ALLOC_PARAMETERS.deviceId */
+#define GUEST_INSTANCE 0              /* the guest's one device */
+
+#define CTRL_GET_ATTACHED_IDS 0x201
+#define CTRL_GET_ID_INFO 0x202
+#define CTRL_GET_DEVICE_IDS 0x204
+#define CTRL_GET_ID_INFO_V2 0x205
+#define CTRL_GET_PROBED_IDS 0x214
+#define CTRL_ATTACH_IDS 0x215
+#define CTRL_DETACH_IDS 0x216
+#define CTRL_GET_PCI_INFO 0x21b
+#define CTRL_GET_UUID_FROM_GPU_ID 0x275
+#define CTRL_QUERY_DRAIN_STATE 0x279
+#define CTRL_GET_MEMOP_ENABLE 0x27b
+#define CTRL_GET_ACTIVE_DEVICE_IDS 0x288
+#define CTRL_ASYNC_ATTACH_ID 0x289
+#define CTRL_WAIT_ATTACH_ID 0x28a
+#define CTRL_GET_P2P_CAPS_MATRIX 0x13a
+#define CTRL_GPU_INTERFACE 0x200      /* NV0000 controls 0x2xx are about GPUs */
+#define CTRL_INTERFACE_MASK 0xffffff00u
+
+#define MAX_GPUS 32                   /* NV0000_CTRL_GPU_MAX_ATTACHED_GPUS and _MAX_PROBED_GPUS */
+#define LIST_BYTES (MAX_GPUS * 4)
+#define NO_GPU 0xffffffffu            /* NV0000_CTRL_GPU_INVALID_ID, after the last of a list */
+#define ALL_GPUS 0x0000ffffu          /* ATTACH_ALL_PROBED_IDS and DETACH_ALL_ATTACHED_IDS */
+#define PROBED_EXCLUDED LIST_BYTES
+#define PROBED_FLAGS (2 * LIST_BYTES)
+#define PROBED_BYTES (3 * LIST_BYTES)
+#define ID_INFO_DEVICE_INSTANCE 8     /* the same place in GET_ID_INFO and its V2 */
+#define PCI_INFO_BYTES 12
+#define PCI_INFO_DOMAIN 4
+#define PCI_INFO_BUS 8
+#define PCI_INFO_SLOT 10
+#define ID_INFO_V2_BYTES 32
+#define ACTIVE_COUNT 0
+#define ACTIVE_FIRST 4
+#define ACTIVE_BYTES 12               /* gpuId, gpuInstanceId, computeInstanceId */
+#define ACTIVE_MAX 256
+#define P2P_GROUP_A_COUNT 0
+#define P2P_GROUP_B_COUNT 4
+#define P2P_GROUP_A 8
+#define P2P_GROUP_MAX 8
+#define P2P_GROUP_B (P2P_GROUP_A + P2P_GROUP_MAX * 4)
+
+#define ESC_CARD_INFO 0xc8
+#define ESC_ATTACH_GPUS_TO_FD 0xd4
+#define FD_LIST_EMPTY 0               /* a place in ATTACH_GPUS_TO_FD's list with no GPU */
+#define CARD_INFO_BYTES 72            /* nv_ioctl_card_info_t */
+#define CARD_INFO_GPU_ID 16
+#define CARD_INFO_MINOR 56
+#define GUEST_MINOR 0                 /* the guest's own device file is /dev/nvidia0 */
+
+static uint32_t read32(const uint8_t *at)
+{
+    uint32_t v;
+    memcpy(&v, at, sizeof(v));
+    return v;
+}
+
+static void write32(uint8_t *at, uint32_t v)
+{
+    memcpy(at, &v, sizeof(v));
+}
+
+static uint16_t read16(const uint8_t *at)
+{
+    uint16_t v;
+    memcpy(&v, at, sizeof(v));
+    return v;
+}
+
+bool card_parse_address(const char *text, CardAddress *address)
+{
+    unsigned domain, bus, device, function;
+    int end = 0;
+
+    if (!text || sscanf(text, "%x:%x:%x.%x%n", &domain, &bus, &device, &function, &end) != 4 ||
+        text[end] || bus > 0xff || device > 0x1f || function > 7) {
+        return false;
+    }
+    *address = (CardAddress) { domain, bus, device, function };
+    return true;
+}
+
+void card_print_address(const CardAddress *address, char *text, size_t size)
+{
+    snprintf(text, size, "%04x:%02x:%02x.%x", address->domain, address->bus, address->device,
+             address->function);
+}
+
+/* ---- finding the card ---- */
+
+static bool is_at(CardControl control, void *opaque, uint32_t gpu, const CardAddress *address)
+{
+    uint8_t info[PCI_INFO_BYTES] = { 0 };
+
+    write32(info, gpu);
+    /* The RM gives no function number. A GPU is always function 0. */
+    return control(opaque, CTRL_GET_PCI_INFO, info, sizeof(info)) == STATUS_OK &&
+           read32(info + PCI_INFO_DOMAIN) == address->domain && read16(info + PCI_INFO_BUS) == address->bus &&
+           read16(info + PCI_INFO_SLOT) == address->device && address->function == 0;
+}
+
+const char *card_find(CardControl control, void *opaque, const CardAddress *address, NvfwdCard *card)
+{
+    uint8_t ids[LIST_BYTES], info[ID_INFO_V2_BYTES] = { 0 };
+    uint32_t count, found = NO_GPU;
+
+    memset(ids, 0xff, sizeof(ids));
+    if (control(opaque, CTRL_GET_ATTACHED_IDS, ids, sizeof(ids)) != STATUS_OK) {
+        return "the driver would not list its GPUs";
+    }
+    for (count = 0; count < MAX_GPUS && read32(ids + count * 4) != NO_GPU; count++) {
+        if (address && is_at(control, opaque, read32(ids + count * 4), address)) {
+            found = read32(ids + count * 4);
+        }
+    }
+    if (!address) {
+        if (count != 1) {
+            return count ? "the host has more than one NVIDIA card, and card= doesn't say which" :
+                           "the driver has no GPU set up";
+        }
+        found = read32(ids);
+    }
+    if (found == NO_GPU) {
+        return "the driver has no GPU set up at that address";
+    }
+    write32(info, found);
+    if (control(opaque, CTRL_GET_ID_INFO_V2, info, sizeof(info)) != STATUS_OK) {
+        return "the driver would not give the GPU's device number";
+    }
+    card->gpu_id = found;
+    card->instance = read32(info + ID_INFO_DEVICE_INSTANCE);
+    return NULL;
+}
+
+/* ---- the guest's calls ---- */
+
+/* A control's or allocation's parameters, when they are at least `need` bytes. */
+static uint8_t *params_of(const uint8_t *arg, uint32_t pointer_at, uint32_t size_at, uint32_t need)
+{
+    uint64_t pointer;
+
+    memcpy(&pointer, arg + pointer_at, sizeof(pointer));
+    if (!pointer || read32(arg + size_at) < need) {
+        return NULL;
+    }
+    return (uint8_t *)(uintptr_t)pointer;
+}
+
+static uint8_t *control_params(const uint8_t *arg, uint32_t size, uint32_t need)
+{
+    return size >= RM_CONTROL_BYTES ? params_of(arg, RM_CONTROL_PARAMS, RM_CONTROL_PARAMS_SIZE, need) : NULL;
+}
+
+/* A list of GPU ids that ends at NO_GPU or its room. Each one has to be the card. */
+static bool only_card_listed(const NvfwdCard *card, uint8_t *list, uint32_t room)
+{
+    uint32_t i;
+
+    if (read32(list) == ALL_GPUS) {
+        /* "Every GPU" means the guest's every GPU. */
+        write32(list, card->gpu_id);
+        if (room > 1) {
+            write32(list + 4, NO_GPU);
+        }
+        return true;
+    }
+    for (i = 0; i < room && read32(list + i * 4) != NO_GPU; i++) {
+        if (read32(list + i * 4) != card->gpu_id) {
+            return false;
+        }
+    }
+    return true;
+}
+
+/* The GPUs a control file is tied to. The kernel passes over a 0, and takes every other entry. */
+static bool fd_list_names_card_only(const NvfwdCard *card, const uint8_t *list, uint32_t count)
+{
+    uint32_t i;
+
+    for (i = 0; i < count; i++) {
+        if (read32(list + i * 4) != FD_LIST_EMPTY && read32(list + i * 4) != card->gpu_id) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool p2p_names_card_only(const NvfwdCard *card, const uint8_t *params)
+{
+    uint32_t a = read32(params + P2P_GROUP_A_COUNT), b = read32(params + P2P_GROUP_B_COUNT), i;
+
+    if (a > P2P_GROUP_MAX || b > P2P_GROUP_MAX) {
+        return false;
+    }
+    for (i = 0; i < a; i++) {
+        if (read32(params + P2P_GROUP_A + i * 4) != card->gpu_id) {
+            return false;
+        }
+    }
+    for (i = 0; i < b; i++) {
+        if (read32(params + P2P_GROUP_B + i * 4) != card->gpu_id) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool control_allowed(const NvfwdCard *card, uint8_t *arg, uint32_t size)
+{
+    uint32_t cmd = read32(arg + RM_CONTROL_CMD);
+    uint8_t *params;
+
+    switch (cmd) {
+    case CTRL_GET_ID_INFO:
+    case CTRL_GET_ID_INFO_V2:
+    case CTRL_GET_PCI_INFO:
+    case CTRL_GET_UUID_FROM_GPU_ID:
+    case CTRL_QUERY_DRAIN_STATE:
+    case CTRL_ASYNC_ATTACH_ID:
+    case CTRL_WAIT_ATTACH_ID:
+        params = control_params(arg, size, 4);
+        return params && read32(params) == card->gpu_id;
+    case CTRL_ATTACH_IDS:
+    case CTRL_DETACH_IDS:
+        params = control_params(arg, size, LIST_BYTES);
+        return params && only_card_listed(card, params, MAX_GPUS);
+    case CTRL_GET_P2P_CAPS_MATRIX:
+        params = control_params(arg, size, P2P_GROUP_B + P2P_GROUP_MAX * 4);
+        return params && p2p_names_card_only(card, params);
+    }
+    return true;
+}
+
+/*
+ * A device allocation's parameters. The RM goes by the class's own size and not the size field, which
+ * the driver leaves at 0, and rmargs.c has made the pointer one into this call that holds that much.
+ */
+static uint8_t *device_params(const uint8_t *arg, uint32_t size)
+{
+    uint64_t pointer;
+
+    if (size < RM_ALLOC_SHORT_BYTES || read32(arg + RM_ALLOC_CLASS) != CLASS_DEVICE) {
+        return NULL;
+    }
+    memcpy(&pointer, arg + RM_ALLOC_PARAMS, sizeof(pointer));
+    return (uint8_t *)(uintptr_t)pointer;
+}
+
+static bool device_allowed(const NvfwdCard *card, uint8_t *arg, uint32_t size)
+{
+    uint8_t *params;
+
+    if (size < RM_ALLOC_SHORT_BYTES || read32(arg + RM_ALLOC_CLASS) != CLASS_DEVICE) {
+        return true;
+    }
+    /* No parameters would mean the RM's first device, which needn't be this card. */
+    params = device_params(arg, size);
+    if (!params || read32(params + DEVICE_PARAMS_ID) != GUEST_INSTANCE) {
+        return false;
+    }
+    write32(params + DEVICE_PARAMS_ID, card->instance);
+    return true;
+}
+
+bool card_allows(const NvfwdCard *card, uint32_t nr, uint8_t *arg, uint32_t size)
+{
+    switch (nr) {
+    case ESC_RM_ALLOC:
+        return device_allowed(card, arg, size);
+    case ESC_RM_CONTROL:
+        return size >= RM_CONTROL_BYTES && control_allowed(card, arg, size);
+    case ESC_ATTACH_GPUS_TO_FD:
+        return size >= 4 && fd_list_names_card_only(card, arg, size / 4);
+    }
+    return true;
+}
+
+/* Keeps the card in a list of GPU ids, first, and ends the list after it. */
+static void keep_card(const NvfwdCard *card, uint8_t *list, uint32_t room)
+{
+    bool listed = false;
+    uint32_t i;
+
+    for (i = 0; i < room && read32(list + i * 4) != NO_GPU; i++) {
+        listed |= read32(list + i * 4) == card->gpu_id;
+    }
+    memset(list, 0xff, room * 4);
+    if (listed) {
+        write32(list, card->gpu_id);
+    }
+}
+
+static void keep_probed_card(const NvfwdCard *card, uint8_t *params)
+{
+    uint32_t flags = 0, i;
+    bool listed = false;
+
+    for (i = 0; i < MAX_GPUS && read32(params + i * 4) != NO_GPU; i++) {
+        if (read32(params + i * 4) == card->gpu_id) {
+            listed = true;
+            flags = read32(params + PROBED_FLAGS + i * 4);
+        }
+    }
+    memset(params, 0xff, 2 * LIST_BYTES); /* the excluded GPUs are other cards too */
+    memset(params + PROBED_FLAGS, 0, LIST_BYTES);
+    if (listed) {
+        write32(params, card->gpu_id);
+        write32(params + PROBED_FLAGS, flags);
+    }
+}
+
+static void keep_active_card(const NvfwdCard *card, uint8_t *params, uint32_t params_size)
+{
+    uint32_t count = read32(params + ACTIVE_COUNT), kept = 0, i;
+    uint32_t room = (params_size - ACTIVE_FIRST) / ACTIVE_BYTES;
+
+    count = count < room ? count : room;
+    count = count < ACTIVE_MAX ? count : ACTIVE_MAX;
+    for (i = 0; i < count; i++) {
+        uint8_t *device = params + ACTIVE_FIRST + i * ACTIVE_BYTES;
+        if (read32(device) == card->gpu_id) {
+            memmove(params + ACTIVE_FIRST + kept++ * ACTIVE_BYTES, device, ACTIVE_BYTES);
+        }
+    }
+    memset(params + ACTIVE_FIRST + kept * ACTIVE_BYTES, 0, (count - kept) * ACTIVE_BYTES);
+    write32(params + ACTIVE_COUNT, kept);
+}
+
+static void fix_control(const NvfwdCard *card, uint8_t *arg, uint32_t size)
+{
+    uint32_t cmd = read32(arg + RM_CONTROL_CMD);
+    uint8_t *params;
+
+    switch (cmd) {
+    case CTRL_GET_ATTACHED_IDS:
+        if ((params = control_params(arg, size, LIST_BYTES))) {
+            keep_card(card, params, MAX_GPUS);
+        }
+        break;
+    case CTRL_GET_PROBED_IDS:
+        if ((params = control_params(arg, size, PROBED_BYTES))) {
+            keep_probed_card(card, params);
+        }
+        break;
+    case CTRL_GET_DEVICE_IDS:
+        if ((params = control_params(arg, size, 4))) {
+            write32(params, card->instance < 32 && (read32(params) >> card->instance & 1) ? 1u << GUEST_INSTANCE : 0);
+        }
+        break;
+    case CTRL_GET_ID_INFO:
+    case CTRL_GET_ID_INFO_V2:
+        /* Only the card's own got this far. */
+        if ((params = control_params(arg, size, ID_INFO_DEVICE_INSTANCE + 4))) {
+            write32(params + ID_INFO_DEVICE_INSTANCE, GUEST_INSTANCE);
+        }
+        break;
+    case CTRL_GET_ACTIVE_DEVICE_IDS:
+        if ((params = control_params(arg, size, ACTIVE_FIRST))) {
+            keep_active_card(card, params, read32(arg + RM_CONTROL_PARAMS_SIZE));
+        }
+        break;
+    }
+}
+
+/* The cards the host's driver has, cut down to this one, which the guest has as /dev/nvidia0. */
+static void fix_card_info(const NvfwdCard *card, uint8_t *arg, uint32_t size)
+{
+    uint32_t count = size / CARD_INFO_BYTES, kept = 0, i;
+
+    for (i = 0; i < count; i++) {
+        uint8_t *info = arg + i * CARD_INFO_BYTES;
+        if (info[0] && read32(info + CARD_INFO_GPU_ID) == card->gpu_id) {
+            memmove(arg, info, CARD_INFO_BYTES);
+            write32(arg + CARD_INFO_MINOR, GUEST_MINOR);
+            kept = 1;
+            break;
+        }
+    }
+    memset(arg + kept * CARD_INFO_BYTES, 0, (count - kept) * CARD_INFO_BYTES);
+}
+
+/* The guest asked for its device 0, and reads back what it asked for. */
+static void fix_device(uint8_t *arg, uint32_t size)
+{
+    uint8_t *params = device_params(arg, size);
+
+    if (params) {
+        write32(params + DEVICE_PARAMS_ID, GUEST_INSTANCE);
+    }
+}
+
+void card_fix_answer(const NvfwdCard *card, uint32_t nr, uint8_t *arg, uint32_t size)
+{
+    if (nr == ESC_RM_ALLOC) {
+        fix_device(arg, size);
+    } else if (nr == ESC_RM_CONTROL && size >= RM_CONTROL_BYTES) {
+        fix_control(card, arg, size);
+    } else if (nr == ESC_CARD_INFO) {
+        fix_card_info(card, arg, size);
+    }
+}
+
+bool card_knows_control(uint32_t cmd)
+{
+    switch (cmd) {
+    case CTRL_GET_ATTACHED_IDS:
+    case CTRL_GET_ID_INFO:
+    case CTRL_GET_DEVICE_IDS:
+    case CTRL_GET_ID_INFO_V2:
+    case CTRL_GET_PROBED_IDS:
+    case CTRL_ATTACH_IDS:
+    case CTRL_DETACH_IDS:
+    case CTRL_GET_PCI_INFO:
+    case CTRL_GET_UUID_FROM_GPU_ID:
+    case CTRL_QUERY_DRAIN_STATE:
+    case CTRL_GET_ACTIVE_DEVICE_IDS:
+    case CTRL_ASYNC_ATTACH_ID:
+    case CTRL_WAIT_ATTACH_ID:
+    case CTRL_GET_P2P_CAPS_MATRIX:
+    case CTRL_GET_MEMOP_ENABLE: /* names no GPU */
+        return true;
+    }
+    return (cmd & CTRL_INTERFACE_MASK) != CTRL_GPU_INTERFACE;
+}
diff --git a/hw/misc/nvfwd/card.h b/hw/misc/nvfwd/card.h
new file mode 100644
index 0000000..55c6979
--- /dev/null
+++ b/hw/misc/nvfwd/card.h
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * The one card a guest gets.
+ *
+ * The host may have several NVIDIA cards, and a guest is given one of them by its PCI address. The
+ * RM names a card three ways: its device file's minor, its GPU id, and its device instance, and none
+ * of them follows from another. So the device looks the card up once, before the guest runs, and
+ * from then on shows the guest that card alone, as device instance 0, which is what a guest with one
+ * card expects. The guest's driver learns what cards there are from a few controls and one ioctl;
+ * their answers are cut down to this card here, and any call naming another GPU is refused.
+ *
+ * The wall is the host's own check, though: the RM makes a device only for a GPU whose device file
+ * the calling process has open, and QEMU opens this card's alone. This file is what keeps the guest's
+ * view of the host consistent with that.
+ */
+#ifndef NVFWD_CARD_H
+#define NVFWD_CARD_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct CardAddress {
+    uint32_t domain;
+    uint8_t bus, device, function;
+} CardAddress;
+
+typedef struct NvfwdCard {
+    uint32_t gpu_id;   /* the RM's id for the card's GPU, which the guest sees as it is */
+    uint32_t instance; /* the RM's device instance for it, which the guest sees as 0 */
+} NvfwdCard;
+
+/* The longest address card_print_address writes, with its end. */
+#define CARD_ADDRESS_TEXT 32
+
+/* domain:bus:device.function in hex, with a domain of any width. */
+bool card_parse_address(const char *text, CardAddress *address);
+
+/* As sysfs names a PCI device, a four-digit domain. */
+void card_print_address(const CardAddress *address, char *text, size_t size);
+
+/* An NV0000 control on a client of the host's: the RM status, or -1 if the call itself failed. */
+typedef int64_t (*CardControl)(void *opaque, uint32_t cmd, void *params, uint32_t size);
+
+/*
+ * Finds the card at the address, or with none, the host's only card. NULL when found, or why not.
+ * The card's device file has to be open already, as that is what sets its GPU up.
+ */
+const char *card_find(CardControl control, void *opaque, const CardAddress *address, NvfwdCard *card);
+
+/*
+ * Before a call goes to the host. False refuses it. A device allocation of the guest's instance 0
+ * is rewritten here to the card's own instance.
+ */
+bool card_allows(const NvfwdCard *card, uint32_t nr, uint8_t *arg, uint32_t size);
+
+/*
+ * After the host answered, whether or not it worked: lists of GPUs and device numbers cut down to
+ * the card, and a device allocation's instance put back as the guest gave it.
+ */
+void card_fix_answer(const NvfwdCard *card, uint32_t nr, uint8_t *arg, uint32_t size);
+
+/* Whether this file knows an NV0000 GPU control: it can't let a GPU control through blind. */
+bool card_knows_control(uint32_t cmd);
+
+#endif
