From 3b93b93621202a84dbf87a1fac6bcc5bf83958d9 Mon Sep 17 00:00:00 2001
From: xnixy <x@ruxn.com>
Date: Fri, 6 Nov 2026 02:17:47 -0800
Subject: [PATCH 24/24] hw/hyperv: add the Time Synchronization integration service

A Windows guest's clock starts from the real-time clock's whole seconds, and
nothing keeps it on the host's time. OpenGL in the guest pairs the host's time
with its own, and goes wrong when the two are apart.

This is the VMBus channel Hyper-V uses for that. Windows binds its own driver and
starts its own service, with no network and no setting changed. The channel is
a message pipe, so an offer can now carry a pipe mode.
---
 hw/hyperv/hv-timesync.c         | 368 ++++++++++++++++++++++++++++++++
 hw/hyperv/meson.build           |   1 +
 hw/hyperv/vmbus.c               |   1 +
 include/hw/hyperv/vmbus-proto.h |   1 +
 include/hw/hyperv/vmbus.h       |   2 +
 5 files changed, 373 insertions(+)
 create mode 100644 hw/hyperv/hv-timesync.c

diff --git a/hw/hyperv/hv-timesync.c b/hw/hyperv/hv-timesync.c
new file mode 100644
index 0000000..2226ba8
--- /dev/null
+++ b/hw/hyperv/hv-timesync.c
@@ -0,0 +1,368 @@
+/*
+ * Hyper-V's Time Synchronization integration service, as a VMBus device.
+ *
+ * Windows keeps a guest's clock on the host's time through this channel, with
+ * no network and no settings changed. The host speaks first: it offers
+ * versions, the guest picks, and then the host sends the time, every few
+ * seconds and once marked as a sync when the channel opens.
+ *
+ * That first sync is the one that counts here. Later samples go to Windows' time
+ * service, which is off unless the PC is in a domain, and more syncs changed
+ * nothing when tried every 30 s with the clocks up to 6 ms apart.
+ *
+ * The messages follow what Linux's drivers/hv/hv_util.c and include/linux/hyperv.h
+ * read and answer.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/error-report.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "qemu/uuid.h"
+#include "hw/hyperv/vmbus.h"
+#include "qom/object.h"
+#include "system/kvm.h"
+#include <linux/kvm.h>
+
+#define TYPE_HV_TIMESYNC "hv-timesync"
+OBJECT_DECLARE_SIMPLE_TYPE(HvTimeSync, HV_TIMESYNC)
+
+#define TIMESYNC_CLASS_ID    "9527e630-d0ae-497b-adce-e80ab0175caf"
+#define TIMESYNC_INSTANCE_ID "2dd1ce17-079e-403c-b352-a1921ee207ee"
+
+#define FIRST_MESSAGE_DELAY_MS 10
+#define SAMPLE_PERIOD_MS 5000
+
+/* 100 ns units between 1 Jan 1601, where Windows counts from, and 1970. */
+#define WINDOWS_EPOCH_TICKS 116444736000000000ULL
+#define NS_PER_TICK 100
+
+#define PIPE_PACKET_DATA 1
+
+#define MESSAGE_NEGOTIATE 0
+#define MESSAGE_TIMESYNC 4
+
+#define FLAG_TRANSACTION 1
+#define FLAG_REQUEST 2
+#define FLAG_RESPONSE 4
+
+#define TIMESYNC_FLAG_SYNC 1
+#define TIMESYNC_FLAG_SAMPLE 2
+
+typedef struct QEMU_PACKED IcVersion {
+    uint16_t major;
+    uint16_t minor;
+} IcVersion;
+
+typedef struct QEMU_PACKED IcHeader {
+    uint32_t pipe_flags;
+    uint32_t pipe_size;
+    IcVersion frame_version;
+    uint16_t type;
+    IcVersion message_version;
+    uint16_t size;
+    uint32_t status;
+    uint8_t transaction;
+    uint8_t flags;
+    uint8_t reserved[2];
+} IcHeader;
+
+typedef struct QEMU_PACKED IcNegotiate {
+    uint16_t frame_versions;
+    uint16_t message_versions;
+    uint32_t reserved;
+} IcNegotiate;
+
+/* What versions from 4.0 send. */
+typedef struct QEMU_PACKED TimeSample {
+    uint64_t parent_time;
+    uint64_t reference_time;
+    uint8_t flags;
+    uint8_t leap_indicator;
+    uint8_t stratum;
+    uint8_t reserved[5];
+} TimeSample;
+
+/* What earlier versions send. */
+typedef struct QEMU_PACKED OldTimeSample {
+    uint64_t parent_time;
+    uint64_t child_time;
+    uint64_t round_trip_time;
+    uint8_t flags;
+    uint8_t reserved[3];
+} OldTimeSample;
+
+/* Framework versions, newest first, then message versions. */
+static const IcVersion frame_versions[] = { { 3, 0 }, { 1, 0 } };
+static const IcVersion message_versions[] = { { 4, 0 }, { 3, 0 }, { 1, 0 } };
+
+#define FIRST_VERSION_WITH_REFERENCE 4
+
+typedef enum Stage {
+    STAGE_CLOSED,
+    STAGE_OFFER_VERSIONS,
+    STAGE_WAIT_VERSIONS,
+    STAGE_SEND_SYNC,
+    STAGE_SEND_SAMPLES,
+} Stage;
+
+struct HvTimeSync {
+    VMBusDevice parent;
+    QEMUTimer *timer;
+    Stage stage;
+    IcVersion frame_version;
+    IcVersion message_version;
+};
+
+static void fill_header(HvTimeSync *sync, IcHeader *header, uint16_t type,
+                        uint16_t size)
+{
+    memset(header, 0, sizeof(*header));
+    header->pipe_flags = PIPE_PACKET_DATA;
+    header->pipe_size = sizeof(*header) - offsetof(IcHeader, frame_version)
+                        + size;
+    header->frame_version = sync->frame_version;
+    header->message_version = sync->message_version;
+    header->type = type;
+    header->size = size;
+    header->flags = FLAG_TRANSACTION | FLAG_REQUEST;
+}
+
+/* False if the ring has no room, which only means this message is skipped. */
+static bool send_message(HvTimeSync *sync, void *message, uint32_t size)
+{
+    VMBusChannel *chan = vmbus_device_channel(&sync->parent, 0);
+
+    if (!chan || vmbus_channel_reserve(chan, 0, size) < 0) {
+        return false;
+    }
+    return vmbus_channel_send(chan, VMBUS_PACKET_DATA_INBAND, NULL, 0,
+                              message, size, false, 0) >= 0;
+}
+
+static void offer_versions(HvTimeSync *sync)
+{
+    struct QEMU_PACKED {
+        IcHeader header;
+        IcNegotiate negotiate;
+        IcVersion versions[ARRAY_SIZE(frame_versions) +
+                           ARRAY_SIZE(message_versions)];
+    } message = { 0 };
+
+    sync->frame_version = (IcVersion) { 0, 0 };
+    sync->message_version = (IcVersion) { 0, 0 };
+    fill_header(sync, &message.header, MESSAGE_NEGOTIATE,
+                sizeof(message) - sizeof(message.header));
+    message.negotiate.frame_versions = ARRAY_SIZE(frame_versions);
+    message.negotiate.message_versions = ARRAY_SIZE(message_versions);
+    memcpy(message.versions, frame_versions, sizeof(frame_versions));
+    memcpy(message.versions + ARRAY_SIZE(frame_versions), message_versions,
+           sizeof(message_versions));
+    if (send_message(sync, &message, sizeof(message))) {
+        sync->stage = STAGE_WAIT_VERSIONS;
+    }
+}
+
+/*
+ * The guest's reference counter, in 100 ns units. KVM counts it from the same
+ * clock it gives here. The guest takes off how old a sample is by this, so the
+ * time it sets doesn't depend on how long the message took to reach it.
+ */
+static uint64_t reference_time(void)
+{
+    struct kvm_clock_data clock = { 0 };
+
+    if (kvm_vm_ioctl(kvm_state, KVM_GET_CLOCK, &clock) < 0) {
+        return 0;
+    }
+    return clock.clock / NS_PER_TICK;
+}
+
+static void send_time(HvTimeSync *sync, uint8_t flags)
+{
+    struct QEMU_PACKED {
+        IcHeader header;
+        union {
+            TimeSample sample;
+            OldTimeSample old_sample;
+        };
+    } message = { 0 };
+    uint64_t reference = reference_time();
+    uint64_t now = qemu_clock_get_ns(QEMU_CLOCK_HOST) / NS_PER_TICK +
+                   WINDOWS_EPOCH_TICKS;
+    bool has_reference =
+        sync->message_version.major >= FIRST_VERSION_WITH_REFERENCE;
+    uint16_t size = has_reference ? sizeof(message.sample)
+                                  : sizeof(message.old_sample);
+
+    fill_header(sync, &message.header, MESSAGE_TIMESYNC, size);
+    if (has_reference) {
+        message.sample.parent_time = now;
+        message.sample.reference_time = reference;
+        message.sample.flags = flags;
+    } else {
+        message.old_sample.parent_time = now;
+        message.old_sample.flags = flags;
+    }
+    if (send_message(sync, &message, sizeof(message.header) + size) &&
+        sync->stage == STAGE_SEND_SYNC) {
+        sync->stage = STAGE_SEND_SAMPLES;
+    }
+}
+
+static void timer_fired(void *opaque)
+{
+    HvTimeSync *sync = opaque;
+
+    switch (sync->stage) {
+    case STAGE_OFFER_VERSIONS:
+        offer_versions(sync);
+        break;
+    case STAGE_SEND_SYNC:
+        send_time(sync, TIMESYNC_FLAG_SYNC);
+        break;
+    case STAGE_SEND_SAMPLES:
+        send_time(sync, TIMESYNC_FLAG_SAMPLE);
+        break;
+    default:
+        return;
+    }
+    if (sync->stage != STAGE_WAIT_VERSIONS) {
+        timer_mod(sync->timer,
+                  qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + SAMPLE_PERIOD_MS);
+    }
+}
+
+/* What the guest chose, which it says by leaving one of each in the list. */
+static void read_versions(HvTimeSync *sync, const uint8_t *data, uint32_t size)
+{
+    IcHeader header;
+    IcNegotiate negotiate;
+    IcVersion chosen[2];
+
+    if (size < sizeof(header) + sizeof(negotiate) + sizeof(chosen)) {
+        warn_report("hv-timesync: the guest took none of the versions offered");
+        return;
+    }
+    memcpy(&header, data, sizeof(header));
+    memcpy(&negotiate, data + sizeof(header), sizeof(negotiate));
+    memcpy(chosen, data + sizeof(header) + sizeof(negotiate), sizeof(chosen));
+    if (header.status || negotiate.frame_versions != 1 ||
+        negotiate.message_versions != 1) {
+        warn_report("hv-timesync: the guest took none of the versions offered");
+        return;
+    }
+    sync->frame_version = chosen[0];
+    sync->message_version = chosen[1];
+    sync->stage = STAGE_SEND_SYNC;
+    timer_mod(sync->timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME));
+}
+
+static void handle_packet(HvTimeSync *sync, VMBusChanReq *req)
+{
+    IcHeader header;
+
+    if (req->msglen < sizeof(header)) {
+        return;
+    }
+    memcpy(&header, req->msg, sizeof(header));
+    if (!(header.flags & FLAG_RESPONSE)) {
+        return;
+    }
+    if (header.type == MESSAGE_NEGOTIATE &&
+        sync->stage == STAGE_WAIT_VERSIONS) {
+        read_versions(sync, req->msg, req->msglen);
+    }
+}
+
+static void channel_notified(VMBusChannel *chan)
+{
+    HvTimeSync *sync = HV_TIMESYNC(vmbus_channel_device(chan));
+    VMBusChanReq *req;
+
+    if (vmbus_channel_recv_start(chan)) {
+        return;
+    }
+    while ((req = vmbus_channel_recv_peek(chan, sizeof(*req)))) {
+        handle_packet(sync, req);
+        vmbus_free_req(req);
+        vmbus_channel_recv_pop(chan);
+    }
+    vmbus_channel_recv_done(chan);
+}
+
+static int channel_opened(VMBusChannel *chan)
+{
+    HvTimeSync *sync = HV_TIMESYNC(vmbus_channel_device(chan));
+
+    sync->stage = STAGE_OFFER_VERSIONS;
+    timer_mod(sync->timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + FIRST_MESSAGE_DELAY_MS);
+    return 0;
+}
+
+static void stop(HvTimeSync *sync)
+{
+    sync->stage = STAGE_CLOSED;
+    timer_del(sync->timer);
+}
+
+static void channel_closed(VMBusChannel *chan)
+{
+    stop(HV_TIMESYNC(vmbus_channel_device(chan)));
+}
+
+static void device_reset(VMBusDevice *vdev)
+{
+    stop(HV_TIMESYNC(vdev));
+}
+
+static void device_realize(VMBusDevice *vdev, Error **errp)
+{
+    HvTimeSync *sync = HV_TIMESYNC(vdev);
+
+    sync->timer = timer_new_ms(QEMU_CLOCK_REALTIME, timer_fired, sync);
+}
+
+static void device_unrealize(VMBusDevice *vdev)
+{
+    HvTimeSync *sync = HV_TIMESYNC(vdev);
+
+    timer_free(sync->timer);
+    sync->timer = NULL;
+}
+
+static void class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    VMBusDeviceClass *vdc = VMBUS_DEVICE_CLASS(klass);
+
+    qemu_uuid_parse(TIMESYNC_CLASS_ID, &vdc->classid);
+    qemu_uuid_parse(TIMESYNC_INSTANCE_ID, &vdc->instanceid);
+    set_bit(DEVICE_CATEGORY_MISC, dc->categories);
+    vdc->channel_flags = VMBUS_CHANNEL_ENUMERATE_DEVICE_INTERFACE |
+                         VMBUS_CHANNEL_NAMED_PIPE_MODE;
+    vdc->pipe_mode = VMBUS_PIPE_MODE_MESSAGE;
+    vdc->vmdev_realize = device_realize;
+    vdc->vmdev_unrealize = device_unrealize;
+    vdc->vmdev_reset = device_reset;
+    vdc->open_channel = channel_opened;
+    vdc->close_channel = channel_closed;
+    vdc->chan_notify_cb = channel_notified;
+}
+
+static const TypeInfo hv_timesync_type = {
+    .name = TYPE_HV_TIMESYNC,
+    .parent = TYPE_VMBUS_DEVICE,
+    .instance_size = sizeof(HvTimeSync),
+    .class_init = class_init,
+};
+
+static void register_type(void)
+{
+    type_register_static(&hv_timesync_type);
+}
+
+type_init(register_type)
