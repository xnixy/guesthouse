     memcpy(dev->config + GPUPV_CFG_CHANNEL, &guid, sizeof(guid));
     stl_le_p(dev->config + GPUPV_CFG_VERSION, s->version);
     stq_le_p(dev->config + GPUPV_CFG_LUID, s->luid);
@@ -467,6 +477,8 @@ static const Property gpupv_render_props[] = {
     DEFINE_PROP_UINT64("luid", GpupvRender, luid, 0x0000000100000abcULL),
     DEFINE_PROP_UINT32("version", GpupvRender, version, 40),
     DEFINE_PROP_UINT32("hostcaps", GpupvRender, hostcaps, 0),
+    DEFINE_PROP_UINT16("vendor-id", GpupvRender, vendor_id, GPUPV_RENDER_VENDOR),
+    DEFINE_PROP_UINT16("device-id", GpupvRender, device_id, GPUPV_RENDER_DEVICE),
 };
 
