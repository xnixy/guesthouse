+    if (status_at < 0) {
+        r->ret = -EINVAL;
+        return;
+    }
+    memcpy(arg + status_at, &status, sizeof(status));
+    r->ret = 0;
+}
+
 static bool client_known(void *opaque, uint32_t client)
 {
     NvfwdState *s = opaque;
@@ -424,6 +439,10 @@ static void forward_ioctl(NvfwdState *s, Bounce *b, uint32_t *held, uint32_t *nh
             }
         }
     }
+    if (!uvm && !card_allows(&s->card, nr, arg, size)) {
+        refuse_other_card(s, r, nr, arg, size);
+        return;
+    }
     if (!uvm) {
         uint32_t refused;
 
@@ -433,6 +452,7 @@ static void forward_ioctl(NvfwdState *s, Bounce *b, uint32_t *held, uint32_t *nh
         refused = account_before(s->objects, &account, &hold);
         if (refused) {
             undo_runs(&account);
+            card_fix_answer(&s->card, nr, arg, size);
             memcpy(arg + account_status_at(nr, size), &refused, sizeof(refused));
             note_once(s, "OVER", "limit", KEY(K_LIMIT, nr), nr);
             r->ret = 0;
@@ -447,6 +467,9 @@ static void forward_ioctl(NvfwdState *s, Bounce *b, uint32_t *held, uint32_t *nh
     } while (rc < 0 && errno == EINTR);
     r->ret = rc < 0 ? -errno : rc;
     s->counters[0]++;
+    if (!uvm) {
+        card_fix_answer(&s->card, nr, arg, size);
+    }
     if (!uvm && nr == ESC_RM_MAP_MEMORY && rc == 0) {
         note_map_access(s, r, arg);
     }
diff --git a/hw/misc/nvfwd/host_card.c b/hw/misc/nvfwd/host_card.c
new file mode 100644
index 0000000..ad6797f
--- /dev/null
+++ b/hw/misc/nvfwd/host_card.c
@@ -0,0 +1,152 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Looks up the card a guest gets, before the guest runs: see card.h. This is the only time QEMU has
+ * a client of its own on the host, and it is gone before the first guest call.
+ */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include <sys/ioctl.h>
+#include "nvfwd.h"
+#include "rm_layout.h"
+
+#define IOCTL_MAGIC 'F'
+#define CLASS_ROOT_CLIENT 0x41
+#define CLASS_DEVICE 0x80
+#define CHECK_DEVICE 0xca000001u
+#define CLIENT_PARAMS_BYTES 120 /* NV0000_ALLOC_PARAMETERS */
+#define DEVICE_PARAMS_BYTES 56  /* NV0080_ALLOC_PARAMETERS */
+#define STATUS_INSUFFICIENT_PERMISSIONS 0x1b
+
+typedef struct LookupClient {
+    int control_fd;
+    uint32_t client;
+} LookupClient;
+
+static int rm_call(int fd, unsigned nr, void *args, size_t size)
+{
+    int rc;
+
+    do {
+        rc = ioctl(fd, _IOC(_IOC_READ | _IOC_WRITE, IOCTL_MAGIC, nr, size), args);
+    } while (rc < 0 && errno == EINTR);
+    return rc;
+}
+
+/* An NVOS21 allocation. Returns the RM status, or -1. */
+static int64_t rm_alloc(LookupClient *c, uint32_t parent, uint32_t object, uint32_t class_id,
+                        void *params, uint32_t size)
+{
+    uint8_t a[RM_ALLOC_SHORT_BYTES] = { 0 };
+    uint64_t pointer = (uintptr_t)params;
+    uint32_t status;
+
+    memcpy(a + RM_ALLOC_ROOT, &c->client, 4);
+    memcpy(a + RM_ALLOC_PARENT, &parent, 4);
+    memcpy(a + RM_ALLOC_OBJECT, &object, 4);
+    memcpy(a + RM_ALLOC_CLASS, &class_id, 4);
+    memcpy(a + RM_ALLOC_PARAMS, &pointer, 8);
+    memcpy(a + RM_ALLOC_SHORT_PARAMS_SIZE, &size, 4);
+    if (rm_call(c->control_fd, ESC_RM_ALLOC, a, sizeof(a))) {
+        return -1;
+    }
+    memcpy(&status, a + RM_ALLOC_SHORT_STATUS, 4);
+    if (!status && !c->client) {
+        memcpy(&c->client, a + RM_ALLOC_OBJECT, 4);
+    }
+    return status;
+}
+
+static int64_t rm_control(void *opaque, uint32_t cmd, void *params, uint32_t size)
+{
+    LookupClient *c = opaque;
+    uint8_t a[RM_CONTROL_BYTES] = { 0 };
+    uint64_t pointer = (uintptr_t)params;
+    uint32_t status;
+
+    memcpy(a + RM_CONTROL_CLIENT, &c->client, 4);
+    memcpy(a + RM_CONTROL_OBJECT, &c->client, 4);
+    memcpy(a + RM_CONTROL_CMD, &cmd, 4);
+    memcpy(a + RM_CONTROL_PARAMS, &pointer, 8);
+    memcpy(a + RM_CONTROL_PARAMS_SIZE, &size, 4);
+    if (rm_call(c->control_fd, ESC_RM_CONTROL, a, sizeof(a))) {
+        return -1;
+    }
+    memcpy(&status, a + RM_CONTROL_STATUS, 4);
+    return status;
+}
+
+static void rm_free_client(LookupClient *c)
+{
+    uint8_t a[RM_FREE_BYTES] = { 0 };
+
+    memcpy(a + RM_FREE_ROOT, &c->client, 4);
+    memcpy(a + 4, &c->client, 4); /* its parent is itself */
+    memcpy(a + RM_FREE_OBJECT, &c->client, 4);
+    rm_call(c->control_fd, ESC_RM_FREE, a, sizeof(a));
+}
+
+/* The RM makes a device only for a GPU whose file this process has open: a wrong card-minor shows. */
+static const char *check_device(LookupClient *c, const NvfwdCard *card)
+{
+    uint8_t params[DEVICE_PARAMS_BYTES] = { 0 };
+    int64_t status;
+
+    memcpy(params, &card->instance, 4);
+    status = rm_alloc(c, c->client, CHECK_DEVICE, CLASS_DEVICE, params, sizeof(params));
+    if (status == STATUS_INSUFFICIENT_PERMISSIONS) {
+        return "card-minor names another card than card=";
+    }
+    return status ? "the driver would not open the card" : NULL;
+}
+
+static const char *look_up(NvfwdState *s, const CardAddress *address)
+{
+    uint8_t client_params[CLIENT_PARAMS_BYTES] = { 0 };
+    LookupClient c = { .control_fd = open("/dev/nvidiactl", O_RDWR | O_CLOEXEC) };
+    const char *why;
+
+    if (c.control_fd < 0) {
+        return "/dev/nvidiactl would not open";
+    }
+    if (rm_alloc(&c, 0, 0, CLASS_ROOT_CLIENT, client_params, sizeof(client_params))) {
+        close(c.control_fd);
+        return "the driver would not make a client";
+    }
+    why = card_find(rm_control, &c, address, &s->card);
+    if (!why) {
+        why = check_device(&c, &s->card);
+    }
+    rm_free_client(&c);
+    close(c.control_fd);
+    return why;
+}
+
+bool host_card_open(NvfwdState *s, Error **errp)
+{
+    CardAddress address;
+    const char *why;
+
+    snprintf(s->card_path, sizeof(s->card_path), "/dev/nvidia%u", s->card_minor);
+    if (s->card_text && !card_parse_address(s->card_text, &address)) {
+        error_setg(errp, "nvfwd: card=%s is not a PCI address", s->card_text);
+        return false;
+    }
+    if (s->card_text) {
+        card_print_address(&address, s->card_sysfs, sizeof(s->card_sysfs));
+    }
+    /* Held for the VM's life: the RM keeps a GPU set up, and its numbers as they are, while it's open. */
+    s->card_fd = open(s->card_path, O_RDWR | O_CLOEXEC);
+    if (s->card_fd < 0) {
+        error_setg_errno(errp, errno, "nvfwd: %s", s->card_path);
+        return false;
+    }
+    why = look_up(s, s->card_text ? &address : NULL);
+    if (why) {
+        error_setg(errp, "nvfwd: %s", why);
+        return false;
+    }
+    fprintf(s->log, "card %s, device file %s, GPU %#x, device instance %u\n",
+            s->card_text ? s->card_sysfs : "(the only one)", s->card_path, s->card.gpu_id, s->card.instance);
+    fflush(s->log);
+    return true;
+}
