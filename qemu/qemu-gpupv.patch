+ */
+static bool start_page(Sensors *s)
+{
+    if (s->page_fd >= 0) {
+        return true;
+    }
+    s->page_fd = memfd_create("nvfwd-sensors", MFD_CLOEXEC);
+    if (s->page_fd < 0) {
