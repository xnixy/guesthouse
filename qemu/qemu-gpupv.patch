     aml_append(dev, aml_name_decl("_CRS", crs));
 
+    if (vmbus_bridge->mmio_size) {
+        Aml *vmod = aml_device("VMOD");
+
+        aml_append(vmod, aml_name_decl("_HID", aml_string("ACPI0004")));
+        aml_append(vmod, aml_name_decl("_UID", aml_int(0x0)));
