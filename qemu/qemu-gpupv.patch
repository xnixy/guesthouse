diff --git a/hw/misc/nvfwd/nvfwd.h b/hw/misc/nvfwd/nvfwd.h
new file mode 100644
index 0000000..3d1d25f
--- /dev/null
+++ b/hw/misc/nvfwd/nvfwd.h
@@ -0,0 +1,126 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * nvfwd: forwards NVIDIA driver calls from a Linux guest to the host's kernel driver.
+ *
+ * BAR0 is a kick register, BAR2 the call slots, BAR4 a window of guest physical space in which host
+ * mappings of /dev/nvidia* appear. A call runs on the vCPU thread that made it, without the BQL, so
+ * there is no hop to another process or thread. This header is what the parts of the device share.
+ */
+#ifndef HW_MISC_NVFWD_H
+#define HW_MISC_NVFWD_H
+
+#include "qemu/thread.h"
+#include "hw/pci/pci_device.h"
+#include "qom/object.h"
+#include "system/memory.h"
+#include "accounting.h"
+#include "bounce.h"
+#include "callrate.h"
+#include "maps.h"
+#include "nvfwd_proto.h"
+#include "objects.h"
+#include "sensors.h"
+
+#define TYPE_NVFWD "nvfwd"
+OBJECT_DECLARE_SIMPLE_TYPE(NvfwdState, NVFWD)
+
+#define MAX_FDS 4096
+#define MAX_RANGES 8192
+#define SEEN_CAPACITY (1 << 16)
+
+typedef struct { uint64_t off, len; } WinRange;
+
+/* Allow list: open addressing, rebuilt from a text file, swapped in whole. */
+typedef struct { uint32_t cap; uint64_t key[]; } AllowSet;
+
+struct NvfwdState {
+    PCIDevice pdev;
+    MemoryRegion mmio, slots, window;
+    uint8_t *slot_mem;
+    uint8_t *win;
+    uint64_t win_size;
+    char *allow_path, *log_path, *sensord_path;
+    bool trace, no_gpu;
+
+    QemuMutex lock;
+    int fds[MAX_FDS];
+    uint8_t fd_kind[MAX_FDS];
+    bool fd_read_only[MAX_FDS]; /* the next mapping of this file was asked for without write */
+    uint32_t fd_holds[MAX_FDS]; /* calls using this entry now */
+    int fd_closing[MAX_FDS];    /* closed by the guest, and to go when the last of those ends */
+    Bounce bounce[NVFWD_SLOTS];
+    WinRange free_ranges[MAX_RANGES];
+    int free_count;
+    AllowSet *allow;
+    time_t allow_mtime;
+    char *show_path; /* path prefix: <path>.sock and <path>.display */
+    QemuMutex show_lock;
+    QemuThread show_thread;
+    int render, listener, viewer;
+    int show_fd[NVFWD_SHOW_SLOTS];
+    uint32_t show_ready, show_pending, show_turn, show_w, show_h, show_pitch;
+    int show_newest;
+    uint64_t show_sequence;
+    uint64_t *show_latest;
+    uint32_t *show_held;
+    uint64_t *show_present;
+    uint64_t *show_reading;
+    uint64_t *show_rate;
+    uint32_t *show_claimed;
+    uint32_t show_have;
+    uint32_t surf_have;
+    int surf_fd[NVFWD_SHOW_MAX_SURFACES];
+    uint32_t surf_w[NVFWD_SHOW_MAX_SURFACES], surf_h[NVFWD_SHOW_MAX_SURFACES];
+    uint32_t surf_pitch[NVFWD_SHOW_MAX_SURFACES], surf_format[NVFWD_SHOW_MAX_SURFACES];
+    uint64_t surf_modifier[NVFWD_SHOW_MAX_SURFACES];
+    AllowSet *seen; /* first-seen keys, for the list of forwarded calls */
+    uint32_t seen_count;
+    Sensors *sensors;
+    Objects *objects;
+    Maps *maps;
+    CallRate rate;
+    uint32_t max_call_rate, max_call_burst, max_objects, max_maps;
+    uint64_t max_vram, max_sysmem, max_uvm;
+    FILE *log;
+    uint64_t counters[8];
+};
+
+enum { K_IOCTL = 1, K_CTRL = 2, K_CLASS = 3, K_UVM = 4, K_MEMCLASS = 5, K_EMUCTRL = 6, K_LIMIT = 7, K_CLIENT = 8 };
+
+#define KEY(kind, value) (((uint64_t)(kind) << 32) | (uint32_t)(value))
+
+/* allow.c */
+bool set_has(AllowSet *s, uint64_t key);
+AllowSet *set_new(uint32_t cap);
+void allow_reload(NvfwdState *s);
+void note_once(NvfwdState *s, const char *outcome, const char *what, uint64_t key, uint64_t value);
+void note_local(NvfwdState *s, const char *what, int kind, uint64_t value);
+bool allowed(NvfwdState *s, const char *what, int kind, uint64_t value);
+
+/* fds.c */
+void throttle(NvfwdState *s);
+int host_fd(NvfwdState *s, uint32_t id);
+bool fd_hold(NvfwdState *s, uint32_t id);
+void fd_release(NvfwdState *s, uint32_t id);
+void fd_close(NvfwdState *s, uint32_t id);
+void do_open(NvfwdState *s, struct nvfwd_req *r);
+
+/* forward.c */
+void unmap_runs(void *opaque, void *range, uint64_t bytes);
+void do_ioctl(NvfwdState *s, Bounce *b);
+
+/* window.c */
+void window_init(NvfwdState *s);
+void do_mmap(NvfwdState *s, struct nvfwd_req *r);
+void do_munmap(NvfwdState *s, struct nvfwd_req *r);
+
+/* show.c */
+void show_init(NvfwdState *s, Error **errp);
+void do_show_buffer(NvfwdState *s, struct nvfwd_req *r);
+void do_show_surface(NvfwdState *s, struct nvfwd_req *r);
+void do_show_next(NvfwdState *s, struct nvfwd_req *r);
+void do_show_frame(NvfwdState *s, struct nvfwd_req *r);
+void do_show_reading(NvfwdState *s, struct nvfwd_req *r);
+void do_show_rate(NvfwdState *s, struct nvfwd_req *r);
+
+#endif
