@@ -456,6 +461,11 @@ static void gpupv_render_realize(PCIDevice *dev, Error **errp)
         return;
     }
 
+    /* The identity Windows sees. Its own virtual render driver binds to the
+     * default, and a guest holding a driver package for another one can be
+     * given that instead. */
+    pci_config_set_vendor_id(dev->config, s->vendor_id);
