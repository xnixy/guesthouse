@@ -196,6 +254,12 @@ static void gpupv_chr_read(void *opaque, const uint8_t *buf, int size)
             break;
         }
 
+        if (le16_to_cpu(f.type) == GPUPV_EVT_ARENA) {
+            gpupv_map_arena(s, s->rx->data + sizeof(f), len);
+            g_byte_array_remove_range(s->rx, 0, sizeof(f) + len);
