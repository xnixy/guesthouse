From 744000abf01095f94435b1e300e95e1913a9941c Mon Sep 17 00:00:00 2001
From: xnixy <x@ruxn.com>
Date: Sun, 8 Nov 2026 14:07:38 -0800
Subject: [PATCH 30/30] hw/pci: make -vga virtio the GL device on a GL display

-vga virtio always made virtio-vga, which has no 3D. The GL device can only
come from -device, which puts it after the machine's own devices, so the
NIC and everything after it move to other addresses than a guest installed
with -vga std has seen.

When the display is GL and the GL device is built in, make virtio-vga-gl
in the VGA's place. Its properties can be set with -global as for any
other -vga.
---
 hw/pci/pci.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/hw/pci/pci.c b/hw/pci/pci.c
index d319160..ff1077c 100644
--- a/hw/pci/pci.c
+++ b/hw/pci/pci.c
@@ -2137,6 +2137,13 @@ PCIDevice *pci_vga_init(PCIBus *bus)
     case VGA_VMWARE:
         return pci_create_simple(bus, -1, "vmware-svga");
     case VGA_VIRTIO:
+        /*
+         * On a GL display, the GL device, in the same place on the bus as
+         * any other -vga, so the devices after it keep their addresses.
+         */
+        if (display_opengl && object_class_by_name("virtio-vga-gl")) {
+            return pci_create_simple(bus, -1, "virtio-vga-gl");
+        }
         return pci_create_simple(bus, -1, "virtio-vga");
     case VGA_NONE:
     default: /* Other non-PCI types. Checking for unsupported types is already
