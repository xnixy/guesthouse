+    DEFINE_PROP_UINT32("max-objects", NvfwdState, max_objects, DEFAULT_MAX_OBJECTS),
+    DEFINE_PROP_UINT32("max-maps", NvfwdState, max_maps, DEFAULT_MAX_MAPS),
+    DEFINE_PROP_SIZE("max-vram", NvfwdState, max_vram, DEFAULT_MAX_VRAM),
+    DEFINE_PROP_SIZE("max-sysmem", NvfwdState, max_sysmem, DEFAULT_MAX_SYSMEM),
+    DEFINE_PROP_SIZE("max-uvm", NvfwdState, max_uvm, DEFAULT_MAX_UVM),
+};
+
+static void nvfwd_class_init(ObjectClass *class, const void *data)
+{
