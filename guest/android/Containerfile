FROM docker.io/library/ubuntu:24.04@sha256:562111b88caa79c71391c0c4d3c2114a7d5c35915c20561fd893cb1e07929e6b
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y git git-lfs python-is-python3 python3-yaml qemu-utils \
    bc bison build-essential ccache curl flex g++-multilib gcc-multilib gnupg gperf imagemagick protobuf-compiler python3-protobuf \
    lib32readline-dev lib32z1-dev libdw-dev libelf-dev lz4 libsdl1.2-dev libssl-dev libxml2 libxml2-utils lzop pngcrush rsync \
    schedtool squashfs-tools xsltproc zip unzip zlib1g-dev meson-1.5 glslang-tools python3-mako fontconfig locales \
 && locale-gen en_US.UTF-8 && curl -fsSL -o /usr/local/bin/repo https://storage.googleapis.com/git-repo-downloads/repo \
 && echo '05f571deafd6ed6da0d20fa707dde29aa5624dbf35553d697a40dbdd4c8d178a  /usr/local/bin/repo' | sha256sum -c - && chmod a+x /usr/local/bin/repo
ENV LANG=en_US.UTF-8
