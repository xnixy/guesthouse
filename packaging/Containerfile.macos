# Where the macOS part is built: reims-vgpu's library, its QEMU on that, and reims-util. It's Ubuntu
# 24.04 for the same reason as Containerfile.qemu, and keeps source packages listed for the libraries
# the part bundles. cmake and the X11, Wayland and EGL headers are for SDL3, which the library builds
# from source and links in. The Rust is the dated nightly reims-vgpu's rust-toolchain.toml names, with
# every target and component it lists, so nothing is fetched into the image's toolchain at build time.
FROM docker.io/library/ubuntu:24.04@sha256:562111b88caa79c71391c0c4d3c2114a7d5c35915c20561fd893cb1e07929e6b
ARG RUST_TOOLCHAIN=nightly-2026-11-03
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RUN sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends build-essential git curl ca-certificates pkg-config \
      python3 python3-venv ninja-build flex bison bzip2 xz-utils cmake binutils dpkg-dev \
      libglib2.0-dev libpixman-1-dev libslirp-dev zlib1g-dev libfdt-dev libpipewire-0.3-dev \
      libusb-1.0-0-dev libseccomp-dev libepoxy-dev libgbm-dev libdrm-dev libegl-dev libgl-dev \
      libx11-dev libxext-dev libxrandr-dev libxcursor-dev libxi-dev libxfixes-dev libxss-dev \
      libxtst-dev libxkbcommon-dev libwayland-dev libwayland-bin libdecor-0-dev libdbus-1-dev \
      libudev-dev \
    && curl -fsSL https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal \
      --default-toolchain "$RUST_TOOLCHAIN" -c rustfmt -c clippy \
      -t aarch64-apple-darwin -t x86_64-apple-darwin -t x86_64-pc-windows-gnullvm \
    && chmod -R a+rX /opt/rustup /opt/cargo
